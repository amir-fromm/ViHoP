# General variables
QUEUE_SHORT=short # Name of short lsf queue
QUEUE_LONG=short
WD=/home/labs/vardi/amirz/pairing/RdRp_Eilat_260215/ViHoP # name of working directory
MAX_MEM=1400000 # Maximum memory available in lsf
DELETE_TMP=false # Delete temporary files

# Values for database editing
RUN_DB_EDIT=false 
DB=/home/labs/vardi/Collaboration/databases/Eilat_2022/palmdb/palmscan_virus_contigs.fasta  # Reference gene set. Will be used for the cell ranger count protocol.
CD_HIT="module load CD-HIT/4.6.6-GCC-10.2.0" # Name of CD-HIT module and version
DEDUP=99 # percent of deduplication
CDHIT_CORES=48 # Number of cores to allocate to cd-hit
CDHIT_MEM=100 # Number of memory per core to allocate to cd-hit
REF_NAME=RNA_VIRUSES_CR # Name the reference for cell ranger

# Values for cell ranger run
RUN_CELL_RANGER=false # Ask if to run cell ranger count stage (in case you don't have cell ranger results)
REF_PATH=/home/labs/vardi/amirz/pairing/RdRp_Eilat_260215/ViHoP # Path of the cell ranger reference
CELL_RANGER="module load CellRanger/10.0.0"
COUNT_CORES=64 # Number of cores to be used for each cell ranger count job
COUNT_MEM=1000 # Memory for each core that will be used for cell ranger count job
MULTIPLE_FASTQ=false # Are there multiple fastq folders
#FASTQDIR='/home/labs/vardi/Collaboration/fastq/20250218_LH00211_0257_A2257TFLT1_10X_Alps_ReseqEilat/Eilat_10X_1,/home/labs/vardi/Collaboration/fastq/20241128_LH00211_0192_A225MKLLT1_10X_Eilat_Meso_Eh35/Eilat_10X_1 /home/labs/vardi/Collaboration/fastq/20250218_LH00211_0257_A2257TFLT1_10X_Alps_ReseqEilat/Eilat_10X_8,/home/labs/vardi/Collaboration/fastq/20241128_LH00211_0192_A225MKLLT1_10X_Eilat_Meso_Eh35/Eilat_10X_8 /home/labs/vardi/Collaboration/fastq/20250218_LH00211_0257_A2257TFLT1_10X_Alps_ReseqEilat/Eilat_10X_3,/home/labs/vardi/Collaboration/fastq/20241128_LH00211_0192_A225MKLLT1_10X_Eilat_Meso_Eh35/Eilat_10X_3' # List of paths for the folders of the fastq files (space delimited). If the folders have a mutual name, like /sample1, /sample2... use the base name: /sample
FASTQDIR='/home/labs/vardi/Collaboration/fastq/20240711_LH00211_0067_A222VJWLT1_10X_Patagonia_Eilat_Alps/Eilat_04' # List of paths for the folders of the fastq files (space delimited). If the folders have a mutual name, like /sample1, /sample2... use the base name: /sample
#EXPECT_CELLS=20000 # Number of expected cells (depends on the number of cells loaded to the 10x Chromium)
#EXPECT_CELLS=10000 # Number of expected cells (depends on the number of cells loaded to the 10x Chromium)
EXPECT_CELLS=false # Number of expected cells (depends on the number of cells loaded to the 10x Chromium)
CREATE_BAM=true
CHEMISTRY=auto # Assay configuration. can be detected automatically if specified "auto"

# Values for choosing infected cells
RUN_CHOOSE_CELLS=false # Ask if to run protocol for finding infected cells (in case you don't have a list of infected cells)
SAMPLE_LIST="Eilat_10X_1,Eilat_10X_3,Eilat_10X_8"
SAMPLE_TABLE=docs/sample_table_fastq.tsv
MIN_UMI=10
MIN_GENE=1 # Minimum cells expressing gene (Sum of cells expressing genes)
OUTPUT_CELLS=list_cells_try.tsv
MEM_CELLS=1024
CORES_CELLS=1

# Values for read extraction
RUN_EXTRACT_READS=false
SEQTK='module load seqtk'
TRIM='module load TrimGalore/0.6.5'
MEM_EXTRACT=500
LIST_CELLS='missing_cells.list'


# Values for assembling cells
RUN_ASSEMBLE_CELLS=false
SPADES='module load SPAdes/3.15.3-GCC-11.2.0'
MEM_SPADES=2000 # Default memory for spades
CORES_SPADES=1

# Values for editing reads
RUN_READ_EDITING=false

# Values for editing contigs
RUN_TRANSCRIPTS_EDITING=false
BBMAP='module load BBMap'
ENTROPY=0.7

# Values for blast 
RUN_BLAST=false
SORT_RNA=true
THREADS_SORTRNA=16
BLAST='module load BLAST/2.11.0-Linux_x86_64'
PR2_FASTA=/home/labs/vardi/Collaboration/databases/pr2/pr2_version_5.0.0_dedup.fasta # path to pr2 database fasta file
PR2_DB=/home/labs/vardi/Collaboration/databases/pr2/pr2_v5 # path to pr2 database + database intitals
METAPR2_DB=/home/labs/vardi/Collaboration/databases/pr2/metapr2_v2 # path to pr2 database + database intitals
CORES_BLAST=32 # number of cores to use for each blast job
MEM_BLAST=1000 # Amount of memory for blast (need to be more than 2000)
EVALUE=1e-10 # Evalue threshold

# Values for 18s last
RUN_18S_LAST=false
MEMORY_LAST=500
CORES_LAST=4
PR2_LAST_DB=/home/labs/vardi/Collaboration/databases/pr2/pr2_v5
LAST_IDENTITY=99 # Threshold for read percent homology, default=99
LAST_LENGTH=88 # Threshold for read alignment length, default=85

# Values for cell annotation
RUN_CELL_ANNOTATION=false
SUMMARIZE_BLAST=true # To summarize the blast results
SUMMARIZE_LAST=true # to summarize the lastal results
REPLACEMENT_FILE=docs/replacement_taxa.tsv
LAST_SUMMARY='false' # A path for the lastal summary file (an intermediate file), if available, to skip the table concatanation step.
TAXONOMIC_LEVEL='Genus' # The taxonomic level by which to subset the data. Default: "Annotation" (The aggregated common names, by 'replacement_taxa.tsv')
BLAST_IDENTITY=98
BLAST_LENGTH=300
LAST_COUNT=10 # Threshold for number of reads to consider
THRESHOLD_CHIMERIC=80 # Threshold for percent mapped reads/alignment length to determine if chimeric or not

# Values for virus blast annotation
RUN_VIRAL_LAST=true
MEMORY_SEARCH=500
CORES_SEARCH=64
LAST_DB_VIRUS_FASTA=/home/labs/vardi/Collaboration/databases/Eilat_2022/palmdb/palmscan_rdrp_genes.faa
LAST_DB_VIRUS=/home/labs/vardi/Collaboration/databases/Eilat_2022/palmdb/palmscan_rdrp_genes_AA

# Values for viral summary
RUN_VIRAL_SUMMARY=false
VIRUS_TAXONOMY=/home/labs/vardi/Collaboration/databases/Eilat_2022/NCLDV_RDRP_taxonomy.csv
VIRUS_BLAST_FILE=mapped_cells_virus/summary_last_combined.tsv
VIRUS_IDENTITY=70
VIRUS_LENGTH=30
