# Gerneral variables
QUEUE_SHORT=short # Name of short lsf queue
WD=/home/labs/vardi/amirz/pairing/Eilat_241201/ViHoP # name of working directory
MAX_MEM=660000 # Maximum memory available in lsf
DELETE_TMP=true # Delete temporary files
# Values for database editing
RUN_DB_EDIT=false 
DB_VIRUS=/home/labs/vardi/amirz/pairing/MetaTEilat_241208/Viral_db_search/ViHoP/Eilat_Viral_MetaT.fasta # Database of viruses. Will be used in both the cell ranger count protocol.
CD_HIT="module load CD-HIT/4.6.6-GCC-10.2.0"
REF_NAME=Eilat_Viral_MetaT_CR # Name the reference for cell ranger


# Values for cell ranger
RUN_CELL_RANGER=false # Ask if to run cell ranger count stage (in case you don't have cell ranger results)
REF_PATH=/home/labs/vardi/amirz/pairing/MetaTEilat_241208/Viral_db_search/ViHoP # Path of the cell ranger reference
CELL_RANGER="module load CellRanger/8.0.0"
COUNT_CORES=24 # Number of cores to be used for each cell ranger count job
COUNT_MEM=2000 # Memory for each core that will be used for cell ranger count job
FASTQDIR='/home/labs/vardi/Collaboration/fastq/20240711_LH00211_0067_A222VJWLT1_10X_Patagonia_Eilat_Alps/Eilat_04Mai' # List of paths for the folders of the fastq files (space delimited). If the folders have a mutual name, like /sample1, /sample2... use the base name: /sample
CREATE_BAM=true
EXPECT_CELLS=10000 # Number of expected cells (depends on the number of cells loaded to the 10x Chromium)
CHEMISTRY=auto # Assay configuration. can be detected automatically if specified "auto"

# Values for editing cell ranger count matrix 
RUN_READ_MTX=false
CORES_MTX=4
MEM_MTX=10000
DIRS_LIST="Eilat_10X_8,Eilat_10X_1,Eilat_10X_3,Eilat_04Mai"

# Values for choosing infected cells
RUN_FIND_INFECTED=false # Ask if to run protocol for finding infected cells (in case you don't have a list of infected cells)
SUM_UMI=1
GENE_COUNT=1
MAX_UMI=1
SAMPLE_TABLE=docs/sample_table_fastq.tsv

# Values for read extraction
RUN_EXTRACT_READS=false
SEQTK='module load seqtk'
TRIM='module load TrimGalore/0.6.5'
MEM_EXTRACT=500

# Values for assembling cells
RUN_ASSEMBLE_CELLS=false
SPADES='module load SPAdes/3.15.3-GCC-11.2.0'
MEM_SPADES=2000 # Default memory for spades
CORES_SPADES=1

# Values for editing reads
RUN_READ_EDITING=false

# Values for editing contigs
RUN_TRANSCRIPTS_EDITING=false
BBMAP='module load BBMap'
ENTROPY=0.7

# Values for blast 
RUN_BLAST=false
RUN_SORTMERNA=true
THREADS_SORTMERNA=16
BLAST='module load BLAST/2.11.0-Linux_x86_64'
PR2_FASTA=/home/labs/vardi/Collaboration/databases/pr2/pr2_version_5.0.0_dedup.fasta # path to pr2 database fasta file
PR2_DB=/home/labs/vardi/Collaboration/databases/pr2/pr2_v5 # path to pr2 database + database intitals
METAPR2_DB=/home/labs/vardi/Collaboration/databases/pr2/metapr2_v2 # path to pr2 database + database intitals
CORES_BLAST=16 # number of cores to use for each blast job
MEM_BLAST=500 # Amount of memory for blast (need to be more than 2000)
EVALUE=1e-10 # Evalue threshold

# Values for 18s last
RUN_18S_LAST=false
MEMORY_LAST=2000
CORES_LAST=4
PR2_LAST_DB=/home/labs/vardi/Collaboration/databases/pr2/pr2_v5

# Values for cell annotation
RUN_CELL_ANNOTATION=false
SUMMARIZE_BLAST=true # To summarize the blast results
SUMMARIZE_LAST=false # to summarize the lastal results
MEM_SUMMARY=10000
CORES_SUMMARY=12
REPLACEMENT_FILE=docs/replacement_taxa.tsv
LAST_SUMMARY='false' # A path for the lastal summary file (an intermediate file), if avaialable, to skip the table concatanation step.
LAST_IDENTITY=99 # Threshold for read percent homology, default=99
LAST_LENGTH=85 # Threshold for read alignment length, default=85
PATH_LAST_SUM='18s_mapping_sum.csv'
PATH_BLAST_SUM='annotation_permissive.csv'
LIST_CELLS='Combined_RAW/infected_cells_new.tsv'

# Values for virus blast annotation
RUN_VIRAL_BLAST=true
BLAST_DB_VIRUS=/home/labs/vardi/Collaboration/databases/Aylward_DB_2024/GV_PLV_MV_RdRp_NC/GV_PLV_MV_RdRp

# Values for viral summary
RUN_VIRAL_SUMMARY=true
VIRUS_TAXONOMY=/home/labs/vardi/Collaboration/databases/GOEV/Edited_GOEV_virophages_Genomic_database_specific.csv
ANNOTATION_FILE=summarized_annotation.csv
VIRUS_BLAST_FILE=blast_results/all_cells.virus.tsv
OUTPUT_PATH=/home/labs/vardi/amirz/pairing/Eilat_241201/ViHoP
VIRUS_IDENTITY=80
VIRUS_LENGTH=100
