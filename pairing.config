# General variables
QUEUE_SHORT=short # Name of short lsf queue
QUEUE_LONG=short
WD=/home/labs/vardi/amirz/pairing/Mesocosm_260323/ViHoP # name of working directory
MAX_MEM=1400000 # Maximum memory available in lsf
DELETE_TMP=false # Delete temporary files

# Values for database editing
RUN_DB_EDIT=false 
DB=/home/labs/vardi/taliasha/fasta/reference_PacBioEhuxTranscriptome2022_EhVM1_2022-10-25/reference_transcriptome_ehux_pacbio_integrated_non_viral_v6_December2021.EhVM1-2022-10-25.derep.clean.fasta  # Reference gene set. Will be used for the cell ranger count protocol.
CD_HIT="module load CD-HIT/4.6.6-GCC-10.2.0" # Name of CD-HIT module and version
DEDUP=99 # percent of deduplication
CDHIT_CORES=48 # Number of cores to allocate to cd-hit
CDHIT_MEM=100 # Number of memory per core to allocate to cd-hit
REF_NAME=Ehux_EhV_CR # Name the reference for cell ranger

# Values for cell ranger run
RUN_CELL_RANGER=false # Ask if to run cell ranger count stage (in case you don't have cell ranger results)
REF_PATH=/home/labs/vardi/amirz/pairing/Mesocosm_260323/ViHoP # Path of the cell ranger reference
CELL_RANGER="module load CellRanger/9.0.0"
COUNT_CORES=64 # Number of cores to be used for each cell ranger count job
COUNT_MEM=1000 # Memory for each core that will be used for cell ranger count job
MULTIPLE_FASTQ=true # Are there multiple fastq folders
FASTQDIR='/home/labs/vardi/Collaboration/fastq/20241128_LH00211_0192_A225MKLLT1_10X_Eilat_Meso_Eh35/Meso_B7T19,/home/labs/vardi/Collaboration/fastq/20250218_LH00211_0257_A2257TFLT1_10X_Alps_ReseqEilat/Meso_B7T19' # List of paths for the folders of the fastq files (space delimited). If the folders have a mutual name, like /sample1, /sample2... use the base name: /sample
EXPECT_CELLS=20000 # Number of expected cells (depends on the number of cells loaded to the 10x Chromium)
CREATE_BAM=true
CHEMISTRY=auto # Assay configuration. can be detected automatically if specified "auto"

# Values for choosing infected cells
RUN_CHOOSE_CELLS=false # Ask if to run protocol for finding infected cells (in case you don't have a list of infected cells)
SAMPLE_LIST="Meso_bus4_28,Meso_B7T19,Meso_B7T19,Mes_6,Mes_7,Mes_3,Mes_4,Mes_5,Mes_8,Mes_1,Mes_2,B4T19,B7T17"
SAMPLE_TABLE=docs/sample_table_fastq.tsv
MIN_UMI=10
MIN_GENE=1 # Minimum cells expressing gene (Sum of cells expressing genes)
OUTPUT_CELLS=list_cells.tsv
MEM_CELLS=1024
CORES_CELLS=8

# Values for read extraction
RUN_EXTRACT_READS=false
SEQTK='module load seqtk'
TRIM='module load TrimGalore/0.6.5'
MEM_EXTRACT=500
LIST_CELLS='new_missing_cells.tsv'


# Values for assembling cells
RUN_ASSEMBLE_CELLS=false
SPADES='module load SPAdes/3.15.3-GCC-11.2.0'
MEM_SPADES=2000 # Default memory for spades
CORES_SPADES=1

# Values for editing reads
RUN_READ_EDITING=false

# Values for editing contigs
RUN_TRANSCRIPTS_EDITING=false
BBMAP='module load BBMap'
ENTROPY=0.7

# Values for blast 
RUN_BLAST=false
SORT_RNA=true
THREADS_SORTRNA=128
MEM_SORTRNA=1024
CONTIG_LENGTH=300 # Minimum contig length for blast
BLAST='module load BLAST/2.11.0-Linux_x86_64'
PR2_FASTA=/home/labs/vardi/Collaboration/databases/pr2/pr2_version_5.0.0_dedup.fasta # path to pr2 database fasta file
PR2_DB=/home/labs/vardi/Collaboration/databases/pr2/pr2_v5 # path to pr2 database + database intitals
METAPR2_DB=/home/labs/vardi/Collaboration/databases/pr2/metapr2_v2 # path to pr2 database + database intitals
CORES_BLAST=128 # number of cores to use for each blast job
MEM_BLAST=100 # Amount of memory for blast 
EVALUE=1e-10 # Evalue threshold

# Values for 18s last
RUN_18S_LAST=false
MEMORY_LAST=500
CORES_LAST=4
PR2_LAST_DB=/home/labs/vardi/Collaboration/databases/pr2/pr2_v5
LAST_IDENTITY=99 # Threshold for read percent homology, default=99
LAST_LENGTH=54 # Threshold for read alignment length, default=85

# Values for cell annotation
RUN_CELL_ANNOTATION=true
SUMMARIZE_BLAST=true # To summarize the blast results
SUMMARIZE_LAST=false # to summarize the lastal results
REPLACEMENT_FILE=docs/replacement_taxa.tsv
LAST_SUMMARY='false' # A path for the lastal summary file (an intermediate file), if available, to skip the table concatanation step.
TAXONOMIC_LEVEL='Family' # The taxonomic level by which to subset the data. Default: "Annotation" (The aggregated common names, by 'replacement_taxa.tsv')
BLAST_IDENTITY=98
BLAST_LENGTH=300
LAST_COUNT=10 # Threshold for number of reads to consider
THRESHOLD_CHIMERIC=80 # Threshold for percent mapped reads/alignment length to determine if chimeric or not

# Values for virus blast annotation
RUN_VIRAL_LAST=false
MEMORY_SEARCH=500
CORES_SEARCH=64
LAST_DB_VIRUS_FASTA=/home/labs/vardi/Collaboration/databases/GVDB/GVDB_markergenes/GVDB.markergenes_prot.faa
LAST_DB_VIRUS=/home/labs/vardi/Collaboration/databases/GVDB/GVDB_markergenes_AA

# Values for viral summary
RUN_VIRAL_SUMMARY=false
VIRUS_TAXONOMY=/home/labs/vardi/Collaboration/databases/Eilat_2022/NCLDV_RDRP_taxonomy.csv
VIRUS_BLAST_FILE=mapped_cells_virus/summary_last_combined.tsv
VIRUS_IDENTITY=70
VIRUS_LENGTH=30
